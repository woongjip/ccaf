---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import venues from '../data/venues.json';
import { site } from '../lib/util';
---
<Base title="오시는 길">
  <PageHead eyebrow="Way to come" title="오시는 길" lead="공연마다 장소가 다르니 관람하시는 공연의 장소를 꼭 확인해 주세요." />
  <section class="section">
    <div class="wrap">
      <h2>서울에서 춘천까지</h2>
      <ul class="prose">
        <li><b>시외버스</b> 동서울터미널, 상봉터미널, 강남터미널 승차 → 춘천시외버스터미널 하차</li>
        <li><b>전철·ITX-청춘열차</b> 경춘선 남춘천역, 춘천역 하차</li>
      </ul>
      <div class="venues">
        {venues.map((v) => (
          <article class="venue">
            <p class="chip">{v.genre}</p>
            <h3>{v.name}</h3>
            <p class="en">{v.en}</p>
            {v.address && <p>{v.address}</p>}
            {v.phone && <p><a href={`tel:${v.phone}`}>{v.phone}</a></p>}
            {v.bus && <p class="bus">버스 · {v.bus}</p>}
            <a class="map" href={`https://map.naver.com/p/search/${encodeURIComponent(v.address ? v.address : '춘천 ' + v.name)}`} target="_blank" rel="noopener">네이버 지도에서 보기 →</a>
          </article>
        ))}
      </div>
      <h2 style="margin-top:72px">축제 사무국</h2>
      <p>{site.contact.address}<br /><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a> · <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />{site.contact.hours}</p>
    </div>
  </section>
</Base>
<style>
  .venues { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 40px; }
  .venue { background: var(--paper); border: 1px solid var(--line);  padding: 22px; }
  .venue .chip { color: var(--hl); margin: 0 0 10px; }
  .venue h3 { margin: 0; } .venue .en { font-family: var(--display); font-size: 14px; color: var(--muted); margin: 0 0 12px; }
  .venue p { margin: 0 0 6px; font-size: 15px; } .bus { color: var(--muted); }
  .map { display: inline-block; margin-top: 10px; font-weight: 800; text-decoration: none; }
</style>
