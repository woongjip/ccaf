---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection, render } from 'astro:content';
const all = (await getCollection('faq')).filter((f) => f.data.lang === 'en').sort((a, b) => a.data.order - b.data.order);
const cats = [...new Set(all.map((f) => f.data.category))];
const items = await Promise.all(all.map(async (f) => ({ f, Content: (await render(f)).Content })));
const jsonld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.body } })) };
---
<Base title="FAQ" lang="en" jsonld={jsonld}>
  <PageHead eyebrow="FAQ" title="Frequently asked questions" lead="Ticket prices, availability and refunds are on the bookon booking page." />
  <section class="section"><div class="wrap narrow">
    {cats.map((c) => (
      <div style="margin-bottom:56px">
        <h2>{c}</h2>
        {items.filter((i) => i.f.data.category === c).map(({ f, Content }) => (
          <details class="faq"><summary>{f.data.question}</summary><div class="a"><Content /></div></details>
        ))}
      </div>
    ))}
  </div></section>
</Base>
