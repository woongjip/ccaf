---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../lib/util';
export async function getStaticPaths() {
  return (await getCollection('notices')).map((n) => ({ params: { id: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Base title={n.data.title} image={n.data.image}>
  <article class="section"><div class="wrap narrow">
    <p class="eyebrow"><a href="/notice" style="text-decoration:none">← 공지사항</a></p>
    <h1 class="nt">{n.data.title}</h1>
    <p class="nd">{fmtDate(n.data.date)}{n.data.deadline && ` · 마감 ${fmtDate(n.data.deadline)}`}</p>
    <div class="prose">
      <Content />
      {n.data.image && <img src={n.data.image} alt={n.data.title} />}
      {n.data.attachments.length > 0 && (
        <ul class="att">{n.data.attachments.map((a) => <li><a href={a.file} download>📎 {a.label}</a></li>)}</ul>
      )}
    </div>
  </div></article>
</Base>
<style>
  .nt { font-size: clamp(28px, 4vw, 44px); }
  .nd { color: var(--muted); font-family: var(--display); margin: 0 0 40px; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
  .att { list-style: none; padding: 0; } .att a { font-weight: 700; }
</style>
